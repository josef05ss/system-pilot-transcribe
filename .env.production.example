APP_NAME=Sistema de Transcripción
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://transcripcion.example.com

DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@postgres.internal:5432/transcriptor_db
REDIS_URL=redis://redis.internal:6379/0

STORAGE_PROVIDER=local
STORAGE_ROOT=/mnt/shared/transcriptor
KEEP_WORK_FILES=false
MAX_UPLOAD_GB=80

# Opción A: servidor GPU propio
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=large-v3
AI_DEVICE=cuda
AI_COMPUTE_TYPE=float16
AI_BATCH_SIZE=4
AI_BEAM_SIZE=5
AI_LANGUAGE=es
MODEL_CACHE_DIR=/opt/models/faster-whisper

# Opción B: Together AI. Sustituir TRANSCRIPTION_PROVIDER y configurar clave.
# TRANSCRIPTION_PROVIDER=together
# TOGETHER_API_KEY=CHANGE_ME
# TOGETHER_MODEL=openai/whisper-large-v3
# TOGETHER_BASE_URL=https://api.together.ai/v1
# TOGETHER_TIMEOUT_SECONDS=1800
# TOGETHER_MAX_RETRIES=3
# TOGETHER_DIARIZE=false

DEFAULT_CHUNK_SECONDS=300
DEFAULT_OVERLAP_SECONDS=3

DIARIZATION_ENABLED=false
HUGGINGFACE_TOKEN=
