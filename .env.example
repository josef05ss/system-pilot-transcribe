APP_NAME=Sistema de Transcripción
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://transcriptor:transcriptor123@localhost:5432/transcriptor_db
REDIS_URL=redis://localhost:6379/0

STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
KEEP_WORK_FILES=false
MAX_UPLOAD_GB=80

# ACTIVO AHORA: ejecución local gratuita por minuto con tu RTX 3060.
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=large-v3
AI_DEVICE=cuda
AI_COMPUTE_TYPE=int8_float16
AI_BATCH_SIZE=2
AI_BEAM_SIZE=3
AI_LANGUAGE=es
MODEL_CACHE_DIR=./storage/model-cache

DEFAULT_CHUNK_SECONDS=300
DEFAULT_OVERLAP_SECONDS=3

# -----------------------------------------------------------------------------
# TOGETHER AI: YA IMPLEMENTADO, PERO DESACTIVADO.
# No descomentes ni cambies TRANSCRIPTION_PROVIDER hasta tener API key y saldo.
