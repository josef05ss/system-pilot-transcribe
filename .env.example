# Copia este archivo a ".env" (mismo nombre de carpeta que docker-compose.yml)
# y completa tu API key. El archivo ".env" NO se sube a git (ver .gitignore).
#
# Consíguela en: https://console.anthropic.com/settings/keys
# Precios actuales: https://www.anthropic.com/pricing
#
# Si dejas esto vacío, la app funciona 100% local (Tesseract + TrOCR),
# sin llamadas a la API ni costo alguno.

ANTHROPIC_API_KEY=

# Opcional: modelo a usar para transcripción (por defecto claude-sonnet-5).
# Podés usar un modelo más económico como claude-haiku-4-5-20251001 si el
# volumen de imágenes es alto, o uno más preciso si lo necesitas.
ANTHROPIC_MODEL=claude-sonnet-5
