# Ajustar únicamente después de medir la GPU del servidor real.
APP_NAME=Sistema de Transcripción
ENVIRONMENT=production
TRANSCRIPTION_PROVIDER=local

WHISPER_MODEL=large-v3
AI_DEVICE=cuda
AI_COMPUTE_TYPE=float16
AI_BATCH_SIZE=4
AI_BEAM_SIZE=5
AI_LANGUAGE=es

# Ejecutar un worker de transcripción por cada GPU física.
# Cada worker se inicia con scripts/start_worker_transcription.ps1 -GpuIndex N
