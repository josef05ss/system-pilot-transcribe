# Copia este archivo como .env y ajusta según tu GPU.

# --- Modelo -----------------------------------------------------------------
# PRODUCCION (GPU >= 24 GB): 8B sin cuantizar. Es la configuracion objetivo.
#   QWEN_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
#   QWEN_LOAD_IN_4BIT=false
#
# DESARROLLO en 12 GB: 8B en 4 bits (requiere `pip install bitsandbytes`).
#   QWEN_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
#   QWEN_LOAD_IN_4BIT=true
#
# Banco de pruebas rapido: 4B.
QWEN_MODEL_NAME=Qwen/Qwen3-VL-4B-Instruct
QWEN_CUDA_DEVICE=0
QWEN_MAX_NEW_TOKENS=4096
QWEN_DTYPE=auto
QWEN_LOAD_IN_4BIT=false

QWEN_FULL_MIN_PIXELS=1000000
QWEN_FULL_MAX_PIXELS=2000000
QWEN_TILE_MAX_PIXELS=1900000

QWEN_TILING=auto
QWEN_TARGET_LINE_PITCH=100
QWEN_MAX_TILES=4
QWEN_TILE_OVERLAP=0.14
QWEN_TILE_TRIGGER_RATIO=1.35
QWEN_TILE_MIN_LONG_SIDE=1000

QWEN_PREPROCESS=auto
QWEN_SHARPEN_ON_UPSCALE=true
QWEN_SKEW_MAX_ANGLE=8

QWEN_LOW_CONFIDENCE_WORD=0.60
QWEN_LOW_CONFIDENCE_PAGE=0.75
QWEN_MAX_REPORTED_WORDS=60

QWEN_HOST=0.0.0.0
QWEN_PORT=8113
