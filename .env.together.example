# COPIAR ESTOS VALORES AL .env SOLO CUANDO EXISTA PRESUPUESTO Y API KEY.
# Mientras tanto, el proyecto debe quedarse con TRANSCRIPTION_PROVIDER=local.

TRANSCRIPTION_PROVIDER=together
TOGETHER_API_KEY=reemplazar_con_api_key_real
TOGETHER_MODEL=openai/whisper-large-v3
TOGETHER_BASE_URL=https://api.together.ai/v1
TOGETHER_TIMEOUT_SECONDS=1800
TOGETHER_MAX_RETRIES=3

# Together puede devolver diarización. Activarla puede cambiar costo/rendimiento
# según el servicio vigente; validar condiciones antes de producción.
TOGETHER_DIARIZE=false
TOGETHER_MIN_SPEAKERS=
TOGETHER_MAX_SPEAKERS=
